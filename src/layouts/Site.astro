---
// Spoločná hlavička dokumentu (SEO, písma, ikony). Hlavička, päta a obsah sú priamo v stránkach.
import '../styles/fonts.css';
import soraLight from '../../assets/fonts/sora-latin-300.woff2?url';
import soraRegular from '../../assets/fonts/sora-latin-400.woff2?url';
import michroma from '../../assets/fonts/michroma-latin-400.woff2?url';

const { title, description, path = '/', noindex = false, ld = [] } = Astro.props;

const canonical = new URL(path, Astro.site).href;
// Náhľad pri zdieľaní (Facebook, WhatsApp, LinkedIn…), 1200 × 630.
const ogImage = new URL('/og-image.png', Astro.site).href;
const ogAlt = 'GridFlow – elektroinštalácie, fotovoltika a revízie';
---
<!doctype html>
<html lang="sk">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{noindex
  ? <meta name="robots" content="noindex, follow">
  : <><meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1"><link rel="canonical" href={canonical}></>}
<meta name="author" content="GridFlow s.r.o.">
<meta name="theme-color" content="#022253">
<meta name="format-detection" content="telephone=no">
<meta property="og:type" content="website">
<meta property="og:locale" content="sk_SK">
<meta property="og:site_name" content="GridFlow">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
{!noindex && <meta property="og:url" content={canonical}>}
<meta property="og:image" content={ogImage}>
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={ogAlt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<meta name="twitter:image:alt" content={ogAlt}>
{/* Favicony: Google vo výsledkoch vyhľadávania berie štvorcovú ikonu s rozmerom násobku 48 px. */}
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-96.png" sizes="96x96" type="image/png">
<link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="preload" href={soraLight} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={soraRegular} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={michroma} as="font" type="font/woff2" crossorigin>
{ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
</head>
<body>
<slot />
<script>
  import '../scripts/reveal.js';
</script>
</body>
</html>
