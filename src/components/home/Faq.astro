---
import Words from '../Words.astro';
import { faq } from '../../data/faq.js';
---
<section class="faq" id="faq">
<div class="wrap faq-grid">
<div><h2 class="h sw"><Words w={['Časté', 'otázky']} /></h2></div>
<div>
{faq.map(({ q, a, ph }) => (
<details class="qa rv"><summary>{q}</summary><p class="ans">{a}{a && ph && ' '}{ph && <span class="ph">{ph}</span>}</p></details>
))}
</div>
</div>
</section>
