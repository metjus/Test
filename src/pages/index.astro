---
import Site from '../layouts/Site.astro';
import { faq } from '../data/faq.js';
import '../styles/home.css';

// Bez PUBLIC_FORM_ENDPOINT beží dopyt v ukážkovom režime: všetko funguje, ale nič sa neodosiela.
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || '';

const title = 'Elektro, fotovoltika a smart domácnosť od projektu po revíziu | GridFlow';
const description =
  'Navrhneme, namontujeme aj zrevidujeme: NN prípojky, fotovoltika, elektroinštalácia rodinného domu, bleskozvody, nabíjačky pre elektromobily a smart domácnosť. Po častiach alebo na kľúč, celé Slovensko.';

const stageDefs = [
  { id: 'proj', title: 'Navrhnúť', sub: 'Projektová dokumentácia', href: '#i-blueprint', node: 'Projekt' },
  { id: 'mont', title: 'Namontovať', sub: 'Realizácia a montáž', href: '#i-hardhat', node: 'Montáž' },
  { id: 'rev', title: 'Zrevidovať', sub: 'Revízia a revízna správa', href: '#i-shield-check', node: 'Revízia' },
  { id: 'kluc', title: 'Všetko na kľúč', sub: 'Od projektu po revíziu', href: '#i-key', node: '' },
];
const subjectDefs = [
  { id: 'nn', label: 'NN elektrická prípojka', href: '#i-pole' },
  { id: 'fve', label: 'Fotovoltika (malý / lokálny zdroj)', href: '#i-solar' },
  { id: 'dom', label: 'Elektroinštalácia rodinného domu', href: '#i-house' },
  { id: 'blesk', label: 'Bleskozvod', href: '#i-rod' },
  { id: 'ev', label: 'Nabíjačka pre elektromobil (wallbox, AC)', href: '#i-ev' },
  { id: 'smart', label: 'Smart domácnosť a automatizácie', href: '#i-smart' },
];

const business = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'GridFlow s.r.o.',
  url: new URL('/', Astro.site).href,
  telephone: '+421910635595',
  description,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Buková ulica 1309/23',
    postalCode: '951 12',
    addressLocality: 'Ivanka pri Nitre',
    addressCountry: 'SK',
  },
  areaServed: { '@type': 'Country', name: 'Slovensko' },
  knowsAbout: ['Projektová dokumentácia elektro', 'Montáž elektroinštalácií', 'Fotovoltika', 'Smart domácnosť', 'Revízie OPaOS E1A, E1B'],
};

// Do FAQPage idú len odpovede, ktoré sú aj na stránke a nie sú zástupným údajom.
const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq
    .filter((item) => item.a)
    .map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
};
---
<Site title={title} description={description} path="/" ld={[business, faqPage]}>
<div class="gf">
