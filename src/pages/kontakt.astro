---
import Site from '../layouts/Site.astro';
import '../styles/contact.css';

// Dopyt sa odošle na dopyt.php (PHP na hostingu pošle e-mail na info@gridflow.sk).
// Iný cieľ sa dá nastaviť premennou PUBLIC_FORM_ENDPOINT.
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || '/dopyt.php';

const services = [
  { id: 'proj', label: 'Navrhnúť (projekt)' },
  { id: 'mont', label: 'Namontovať' },
  { id: 'rev', label: 'Zrevidovať' },
  { id: 'kluc', label: 'Všetko na kľúč' },
];
const purposes = [
  { id: 'nn', label: 'Elektrická prípojka' },
  { id: 'fve', label: 'Fotovoltika pre domy a firmy' },
  { id: 'dom', label: 'Elektroinštalácia' },
  { id: 'blesk', label: 'Bleskozvod' },
  { id: 'ev', label: 'Nabíjačka pre elektromobil' },
  { id: 'smart', label: 'Inteligentná domácnosť a riadenie energií' },
  { id: 'poradit', label: 'Nie som si istý – potrebujem poradiť' },
];
const prefs = [{ id: 'call', label: 'Zavolať mi', on: true }, { id: 'sms', label: 'Napísať SMS' }, { id: 'mail', label: 'Napísať e-mail' }];
const whens = [{ id: 'any', label: 'Kedykoľvek', on: true }, { id: 'am', label: 'Dopoludnia' }, { id: 'pm', label: 'Popoludní' }];
---
<Site
  title="Kontakt a nezáväzný dopyt | GridFlow"
  description="Zavolajte alebo pošlite krátky dopyt: projekt, montáž aj revízia. Elektroinštalácie, fotovoltika, revízie aj inteligentná domácnosť. Pôsobíme na celom Slovensku."
  path="/kontakt/"
>
<div class="gf">
<a class="skip" href="#obsah">Preskočiť na obsah</a>
<div class="curtain" aria-hidden="true"><i></i><i></i></div>
<header class="nav solid" id="top">
<div class="wrap navbar">
<a class="brand" href="/" aria-label="GridFlow – späť na web"><img src="/logo/gridflow-horizontal-reversed.svg" alt="GridFlow" width="190" height="37"></a>
<div class="navcta">
<a class="kbtn" href="/kontakt/" aria-current="page">Kontakt</a>
</div>
</div>
</header>
<main id="obsah">

<section class="khero">
<div class="radar" aria-hidden="true"><i></i><i></i><i></i><b></b></div>
<div class="wrap">
<h1 aria-label="Kontakt"><span class="w"><span class="wi" style="--i:0">Kontakt</span></span></h1>
<p class="ksub hf" style="--d:500ms">Pôsobíme na celom Slovensku</p>
</div>
</section>

<section class="kbody">
<div class="wrap kgrid">
<aside class="kinfo">
<div><p class="k">Radšej zavoláte?</p><p class="v">Zavolajte a poradíme vám, čo presne potrebujete.</p></div>
<div><p class="k">Čo pre vás urobíme</p><p class="v">Projekt, montáž aj revíziu.<br>Elektroinštalácie, fotovoltika aj inteligentná domácnosť od jedného dodávateľa.</p></div>
<div><p class="k">Fakturačné údaje</p><p class="v">GridFlow s.r.o.<br>IČO: 57813329<br>DIČ: 2123216007<br>Buková ulica 1309/23<br>951 12 Ivanka pri Nitre</p></div>
<div><p class="k">Telefón</p><a class="kmail" href="tel:+421910635595">0910 635 595</a></div>
<div><p class="k">E-mail</p><a class="kmail" href="mailto:info@gridflow.sk">info@gridflow.sk</a></div>
</aside>

<div class="kcard">
<div data-k-form data-endpoint={endpoint}>
<h3>Nezáväzný dopyt</h3>
<p class="hint">Vyberte, čo potrebujete. Ak si nie ste istí, stačí meno a telefón alebo e-mail, poradíme vám.</p>
<span class="lbl first"><b class="n">1</b>Kam sa vám môžeme ozvať?</span>
<div class="two">
<label class="fld"><span>Meno</span><input class="inp" type="text" name="name" autocomplete="name" placeholder="Meno a priezvisko" required minlength="2" data-f-name></label>
<label class="fld"><span>Telefón</span><input class="inp" type="tel" name="tel" inputmode="tel" autocomplete="tel" placeholder="0900 000 000" data-f-phone></label>
</div>
<label class="fld fld-mail"><span>E-mail <small>(ak chcete komunikovať písomne)</small></span><input class="inp" type="email" name="email" autocomplete="email" placeholder="meno@firma.sk" data-f-email></label>
<span class="lbl"><b class="n">2</b>Čo chcete, aby sme spravili? <small>(môžete vybrať viac)</small></span>
<div class="chips" role="group" data-group="services" data-mode="multi" data-exclusive="kluc">
{services.map((c) => (
<button type="button" class={`chip${c.on ? ' on' : ''}`} aria-pressed={c.on ? 'true' : 'false'} data-id={c.id}>{c.label}</button>
))}
</div>
<span class="lbl"><b class="n">3</b>Čoho sa to týka? <small>(môžete vybrať viac)</small></span>
<div class="chips" role="group" data-group="purposes" data-mode="multi" data-exclusive="poradit">
{purposes.map((c) => (
<button type="button" class={`chip${c.on ? ' on' : ''}`} aria-pressed={c.on ? 'true' : 'false'} data-id={c.id}>{c.label}</button>
))}
</div>
<span class="lbl"><b class="n">4</b>Obec alebo mesto <small>(nepovinné)</small></span>
<input class="inp" type="text" name="town" autocomplete="address-level2" placeholder="Kde sa objekt nachádza" data-f-town>
<span class="lbl"><b class="n">5</b>Ako sa vám ozvať?</span>
<div class="chips" role="group" data-group="pref" data-mode="single">
{prefs.map((c) => (
<button type="button" class={`chip${c.on ? ' on' : ''}`} aria-pressed={c.on ? 'true' : 'false'} data-id={c.id}>{c.label}</button>
))}
</div>
<span class="lbl"><b class="n">6</b>Kedy sa vám ozvať?</span>
<div class="chips" role="group" data-group="when" data-mode="single">
{whens.map((c) => (
<button type="button" class={`chip${c.on ? ' on' : ''}`} aria-pressed={c.on ? 'true' : 'false'} data-id={c.id}>{c.label}</button>
))}
</div>
<span class="lbl"><b class="n">7</b>Poznámka <small>(nepovinné)</small></span>
<textarea class="inp" name="note" placeholder="Napríklad rozsah, termín alebo čo už máte hotové" data-f-note></textarea>
<input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" data-f-hp>
<div class="dlg-actions">
<button type="button" class="btn-send" disabled data-send>Odoslať nezáväzný dopyt</button>
</div>
<p class="ferr" data-ferr hidden role="alert">Dopyt sa nepodarilo odoslať. Údaje ostali vyplnené, skúste to znova alebo zavolajte na <a class="plink" href="tel:+421910635595">0910 635 595</a>.</p>
<p class="fine">Odoslať sa dá po vyplnení mena a telefónu alebo e-mailu. Dopyt vás k ničomu nezaväzuje. Údaje použijeme len na vybavenie dopytu. Viac v <a class="plink" href="/zasady-ochrany-osobnych-udajov/">Zásadách ochrany osobných údajov</a>.</p>
</div>
<div class="ok" data-k-ok hidden tabindex="-1">
<div class="tick"><svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true" focusable="false"><path d="M6 15.5l6 6L24 9" stroke="#02ACC1" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" fill="none"></path></svg></div>
<h3 style="margin-bottom:6px" data-ok-title>Ďakujeme, dopyt je odoslaný.</h3>
<p>Ozveme sa vám <span data-sum="kam"></span>.</p>
<ul class="sum">
<li><span>Čo chcete spraviť</span><span data-sum="services"></span></li>
<li><span>Čoho sa to týka</span><span data-sum="purposes"></span></li>
<li><span>Spôsob kontaktu</span><span data-sum="pref"></span></li>
</ul>
<p class="demo" data-demo hidden>Ukážkový režim: dopyt sa zatiaľ nikam neodoslal.</p>
<div class="dlg-actions"><button type="button" class="btn-back" data-again>Poslať ďalší dopyt</button></div>
</div>
</div>
</div>
</section>

<section class="after">
<div class="wrap">
<h2 class="h sw"><span class="w"><span class="wi" style="--i:0">Čo</span></span> <span class="w"><span class="wi" style="--i:1">bude</span></span> <span class="w"><span class="wi" style="--i:2">nasledovať</span></span></h2>
<ol class="s3">
<li class="rv"><span class="no">1</span><h3>Ozveme sa vám</h3><p>Telefonicky, SMS alebo e-mailom, podľa vašej voľby.</p></li>
<li class="rv"><span class="no">2</span><h3>Dohodneme rozsah a termín</h3><p>Prejdeme, čo treba navrhnúť, namontovať alebo zrevidovať.</p></li>
<li class="rv"><span class="no">3</span><h3>Zrealizujeme to</h3><p>V dohodnutom termíne a s jasným výsledkom: projektom, hotovou montážou alebo revíznou správou.</p></li>
</ol>
</div>
</section>

</main>

<footer class="foot-wrap">
<div class="wrap foot">
<img src="/logo/gridflow-horizontal-reversed.svg" alt="GridFlow" width="170" height="33">
<p class="legal">GridFlow s.r.o.<br>IČO: 57813329 · DIČ: 2123216007<br>Buková ulica 1309/23, 951 12 Ivanka pri Nitre</p>
<p class="legal r">© 2026 GridFlow s.r.o.<br><a class="flink" href="/zasady-ochrany-osobnych-udajov/">Zásady ochrany osobných údajov</a></p>
</div>
</footer>
</div>
<script>
  import '../scripts/contact.js';
</script>
</Site>
